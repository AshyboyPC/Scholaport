# Paste this file into Vercel's "Environment Variables" bulk editor.
# Replace every CHANGE_ME value before deploying.

# Public application URL
# For the first deployment, use the intended production URL.
# Update it to the exact Vercel/custom-domain URL and redeploy if Vercel assigns a different URL.
VITE_APP_URL=https://scholaport.vercel.app
VITE_API_BASE_URL=/api/v1
NODE_ENV=production
MAX_UPLOAD_MB=50

# Supabase — required for login, profiles, transcripts, workflow data, and the waitlist
VITE_SUPABASE_URL=https://CHANGE_ME.supabase.co
VITE_SUPABASE_ANON_KEY=CHANGE_ME
SUPABASE_URL=https://CHANGE_ME.supabase.co
SUPABASE_ANON_KEY=CHANGE_ME
VITE_ENABLE_DEV_ACCESS=false
VITE_ENABLE_GOOGLE_AUTH=true

# Google Document AI — required for the live transcript OCR feature
GOOGLE_DOCUMENT_AI_PROJECT_ID=CHANGE_ME
GOOGLE_DOCUMENT_AI_LOCATION=us
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=CHANGE_ME
# Paste the COMPLETE Google service-account JSON as one line.
# Keep \n escapes inside private_key; do not use a local GOOGLE_APPLICATION_CREDENTIALS path on Vercel.
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"CHANGE_ME","private_key_id":"CHANGE_ME","private_key":"-----BEGIN PRIVATE KEY-----\nCHANGE_ME\n-----END PRIVATE KEY-----\n","client_email":"CHANGE_ME@CHANGE_ME.iam.gserviceaccount.com","client_id":"CHANGE_ME","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"CHANGE_ME","universe_domain":"googleapis.com"}'

# Transcript AI extraction, translation, mapping, gap summaries, and structured AI
OPENAI_API_KEY=CHANGE_ME
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional alternative/fallback AI provider — leave unset if you do not use Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TRANSCRIPT_MODEL=gemini-2.5-flash

# Current Lovable-backed advisor/chat routes — required only if those routes are enabled
LOVABLE_API_KEY=CHANGE_ME

# Optional OCR fallbacks — leave blank when Google Document AI is your configured OCR provider
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-2512
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Waitlist sender metadata.
# Note: the current email sender uses a Cloudflare Email binding, which Vercel cannot create from env vars.
# Waitlist requests will still be saved in Supabase, but confirmation email needs a Vercel-compatible provider.
WAITLIST_EMAIL_FROM=
WAITLIST_EMAIL_REPLY_TO=

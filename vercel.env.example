# Replace the placeholder values, then paste this entire file into Vercel.
# Do not commit a copy containing real secrets.

# Public application settings
VITE_APP_URL=https://YOUR-PROJECT.vercel.app
VITE_API_BASE_URL=/api/v1
VITE_ENABLE_DEV_ACCESS=false
VITE_ENABLE_GOOGLE_AUTH=true

# Supabase — required
VITE_SUPABASE_URL=https://YOUR-SUPABASE-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_URL=https://YOUR-SUPABASE-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server settings
NODE_ENV=production
MAX_UPLOAD_MB=50

# AI features — optional
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPT_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TRANSCRIPT_MODEL=gemini-2.5-flash
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-2512

# Google Document AI — optional
GOOGLE_DOCUMENT_AI_PROJECT_ID=
GOOGLE_DOCUMENT_AI_LOCATION=us
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Waitlist email — optional
WAITLIST_EMAIL_FROM=
WAITLIST_EMAIL_REPLY_TO=

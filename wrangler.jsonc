{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "scholaport-web-mvp",
  "compatibility_date": "2026-06-20",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./dist/server/server.js",
  "keep_vars": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
  },
  "send_email": [
    {
      "name": "EMAIL",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
